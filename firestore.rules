rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /trips/{tripId} {
      allow create: if (request.auth != null && request.resource.data.userId == request.auth.uid) || (request.resource.data.userId is string && request.resource.data.userId.matches('^guest-.*'));
      allow read, update, delete: if (request.auth != null && resource.data.userId == request.auth.uid) || (resource.data.userId is string && resource.data.userId.matches('^guest-.*'));
    }
  }
}
